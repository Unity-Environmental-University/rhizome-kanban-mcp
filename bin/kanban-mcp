#!/usr/bin/env python3
"""Thin launcher so MCP clients can exec a single binary."""

import os
import sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)
from kanban_mcp.mcp_server import main


if __name__ == "__main__":
    main()
